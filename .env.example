# Variables de Entorno - Blog Nehoraj
# IMPORTANTE: No subir este archivo a git. Verificar que esté en .gitignore

# Supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave SECRETA del backend (Supabase > Settings > API Keys > secret / service_role).
# Ignora RLS: la autorización real la hace el JWT propio en authenticateToken.
# NUNCA debe llegar al navegador ni subirse a git.
SUPABASE_SECRET_KEY=sb_secret_...

# Clave pública (anon / sb_publishable_...). Solo se usa como respaldo si no hay
# SUPABASE_SECRET_KEY. Con ella el backend queda sujeto a RLS y no puede moderar
# comentarios ni publicar, así que en producción define siempre la secreta.
SUPABASE_KEY=sb_publishable_...

# JWT Secret - Usa una frase larga y segura
JWT_SECRET=nehoraj-mi-frase-secreta-muy-larga-2026

# Vercel Blob (si usas ng serve localmente no aplica, pero Vercel lo inyecta automáticamente)
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# OpenAI (usado por el backend en /api/chat, nunca se expone al navegador)
openaiApiKey=sk-...
